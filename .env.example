MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?appName=<app>
PORT=3000
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Email (optional; leave SMTP_HOST empty to disable receipt email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=POS System
